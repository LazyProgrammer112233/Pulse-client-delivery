# Postgres connection string. On Vercel this comes from the Neon integration.
DATABASE_URL="postgres://portal:portal@localhost:5432/portal"

# Random secret used to sign password reset codes: openssl rand -base64 32
AUTH_SECRET=""

# Email (SMTP) for password reset codes and hand-off nudges. Free options: Brevo (300 emails/day) or a Gmail app password.
# Without these, local development prints emails in the terminal instead of sending them.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Pulse Delivery <the-sender-you-verified@example.com>"

# Comma-separated emails that become admins when they register
ADMIN_EMAILS="ishan@flick2know.com"
