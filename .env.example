# Postgres connection string. On Vercel this comes from the Neon integration.
DATABASE_URL="postgres://portal:portal@localhost:5432/portal"

# Auth.js secret: generate with `npx auth secret`
AUTH_SECRET=""

# Microsoft Entra ID (Azure AD) app registration
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Only emails on this domain may sign in
ALLOWED_EMAIL_DOMAIN="flick2know.com"

# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS="ishan@flick2know.com"

# Local development only: shows an email-only sign-in form. Never set in production.
AUTH_DEV_LOGIN="false"
