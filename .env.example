# Postgres connection string. On Vercel this comes from the Neon integration.
DATABASE_URL="postgres://portal:portal@localhost:5432/portal"

# Auth.js secret: generate with `npx auth secret`
AUTH_SECRET=""

# Email (SMTP) for sign-in codes. Free options: Brevo (300 emails/day) or a Gmail app password.
# Without these, local development prints the code in the terminal instead of emailing it.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Pulse Delivery <the-sender-you-verified@example.com>"

# Optional: Microsoft 365 sign-in. The button appears only when all three are set.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS="ishan@fieldassist.com"
